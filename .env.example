# bili_summary 配置示例
# 用法：复制本文件为 .env 使用，或直接运行 python bili_summary.py --setup 自动生成
# 优先级：命令行参数 > 真实环境变量 > 项目目录 .env 文件 > 代码默认值

# ── DeepSeek（仅“转写+AI总结”模式需要；只转写可留空）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_FALLBACK=deepseek-reasoner

# ── Whisper 模型（大文件，默认在线下载，位置可在 --setup 里选）──
# 内置可选: tiny / base / small / medium / large-v3（越大越准、越慢、越吃内存）
# 也可填本地模型目录绝对路径（已安装模型直接调用，跳过下载）
WHISPER_SIZE=small

# 模型缓存目录（在线下载的模型存放处）:
#   留空 = 用户缓存 ~/.cache/huggingface（默认，跨项目复用）
#   项目内 models/（随项目走，拷项目即带走模型）或任意自定义路径（如 D:/models）
# HF_HOME=~/.cache/huggingface

# ── 硬件加速（默认自动，以下为手动覆盖）──
# 留空 = 自动探测：有 NVIDIA GPU 用 cuda+float16，否则 cpu+int8
# 手动关闭 GPU: WHISPER_DEVICE=cpu  WHISPER_COMPUTE_TYPE=int8
# 手动强制 GPU: WHISPER_DEVICE=cuda WHISPER_COMPUTE_TYPE=float16（需已装 CUDA 驱动）
# WHISPER_DEVICE=
# WHISPER_COMPUTE_TYPE=

# ── 并行（默认自动开启）──
# auto = 按 CPU 核数自动（上限 4 路；GPU 设备默认单路）；1 = 关闭并行；N = 固定 N 路
BILI_PARALLEL=auto

# ── 运行参数（命令行参数同样可用且优先级更高；在文件里改则每次生效）──
# BILI_SKIP_EXISTING=0    # 1=断点续传，跳过已转写过的视频（--skip-existing）
# BILI_WITH_TIMESTAMPS=0  # 1=额外生成带时间戳的 .srt 字幕（--with-timestamps）
# BILI_NO_SUMMARY=0       # 1=只转写不调 AI（--no-summary）

# ── 模型下载镜像 ──
# 中国大陆网络建议用镜像
# HF_ENDPOINT=https://hf-mirror.com

# ── 其他 ──
# BILI_OUTPUT_DIR=./output
# BILI_VENV_DIR 必须是真实环境变量（.env 里设置不生效），默认 脚本目录/.venv

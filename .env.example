# ─────────────────────────────────────────────────────────────
# aicbili 配置示例：复制为 .env 后填写
# 优先级：命令行参数 > 真实环境变量 > .env > 代码默认值
# ─────────────────────────────────────────────────────────────

# ═══ 1. B站登录态（强烈建议配！）═══
# 配了以后：① 能拿 1080P（不配只有 480P）② 能用 B站 AI 字幕 → 直接跳过 ASR，速度最快
# 获取方式：浏览器登录 B站 → F12 → Application/存储 → Cookies → 复制 SESSDATA 的值
AICBILI_SESSDATA=

# ═══ 2. 多模态模型（"看画面"必需）═══
# 任何 OpenAI 兼容端点都行，--provider 有预设：
#   deepseek | dashscope(通义) | ark(豆包) | zhipu | siliconflow | openai | ollama(本地)
#
# 推荐 DeepSeek：一把 key 同时干「看图」和「写总结」，deepseek-flash 已支持图片输入
AICBILI_PROVIDER=deepseek
AICBILI_VLM_API_KEY=
AICBILI_VLM_BASE_URL=https://api.deepseek.com/v1
AICBILI_VLM_MODEL=deepseek-flash
# 模型名写错时自动回退（deepseek-v4-pro 是纯文本，仅作兜底）
AICBILI_VLM_FALLBACK_MODEL=deepseek-v4-pro

# 本地推理（可选，不想花 API 钱又不怕慢）：
#   1) 安装 ollama 并 ollama pull qwen2.5vl:3b
#   2) 改用下面三行（api_key 随便填个非空值）
# AICBILI_PROVIDER=ollama
# AICBILI_VLM_BASE_URL=http://localhost:11434/v1
# AICBILI_VLM_MODEL=qwen2.5vl:3b
# AICBILI_VLM_API_KEY=local

# ═══ 3. 纯文本总结模型（留空 = 复用上面那套）═══
# 想要"看画面用视觉模型、写总结用便宜的文本模型"时再填
# AICBILI_TEXT_API_KEY=
# AICBILI_TEXT_BASE_URL=https://api.deepseek.com/v1
# AICBILI_TEXT_MODEL=deepseek-chat

# ═══ 4. 抽帧策略 ═══
# 送给视觉模型的画面数量上限（越多越全，越慢越贵）
AICBILI_MAX_FRAMES=24
# 单帧最长边像素。1280 足够看清代码/PPT；显存紧张可降到 960
AICBILI_FRAME_WIDTH=1280
# 每张拼图放几帧（4=2x2，6=3x2，9=3x3）
# DeepSeek/通义这类模型会把每张图压到「约 1300x1300 像素」并封顶 1024 tokens，
# 所以 6 帧一张（1920x772）仍在预算内，是最省 token 的甜点；9 帧会被降采样、字会变小
AICBILI_SHEET_GRID=6
# 场景变化阈值 0~1：越低越敏感（幻灯片类建议 0.08~0.12，实拍类 0.15~0.25）
AICBILI_SCENE_THRESHOLD=0.12
# 1=用B站预生成快照做场景检测（极省流量，默认开）；0=直接均匀采样
AICBILI_USE_STORYBOARD=1

# ═══ 5. 语音转写 ═══
# auto = 有 B站字幕就用字幕；否则云端 ASR → whisper.cpp → faster-whisper 依次尝试
# 可选：auto | subtitle(只用B站字幕) | openai(云端) | whisper_cpp(本地,推荐) | local(faster-whisper)
AICBILI_ASR_BACKEND=auto

# ── 本地 whisper.cpp（免费、无需联网 AI；Arch 官方仓库有包）──
#   sudo pacman -S whisper-cpp
#   mkdir -p ~/.cache/whisper-cpp && cd ~/.cache/whisper-cpp
#   curl -L -O https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin
# 留空 = 自动在 ~/.cache/whisper-cpp、./models 等处找 ggml-*.bin
# AICBILI_WHISPER_CPP_MODEL=
# 留空 = 自动找 whisper-cli / whisper-cpp / main
# AICBILI_WHISPER_CPP_BIN=
# 语言：auto=自动识别（推荐，B站有大量英文原声）；填 zh 只处理中文，略快略准
AICBILI_WHISPER_LANGUAGE=auto
# 本地转写线程数（留空=核数-1；批量时会自动按 jobs 分摊）
# AICBILI_WHISPER_THREADS=
# 云端 ASR 模型名（走 /audio/transcriptions 端点时用）
# AICBILI_ASR_MODEL=whisper-1
# 本地转写（需 pip install 'aicbili[local-asr]'）
AICBILI_WHISPER_MODEL=small
# 留空=自动探测（有 NVIDIA GPU 用 cuda+float16，否则 cpu+int8）
# AICBILI_WHISPER_DEVICE=
# AICBILI_WHISPER_COMPUTE=
# 音频转码码率（16k 单声道；越低越快越小，太高没意义）
AICBILI_AUDIO_BITRATE=48k
# 音频分几个窗口并发拉取（突破单连接限速，网络差可调大）
AICBILI_AUDIO_WINDOWS=4

# ═══ 6. 运行参数 ═══
# 单视频内并发数（抽帧 / 视觉请求）
AICBILI_CONCURRENCY=6
# auto=抽帧+转写(默认) | frames | native(模型直读远端视频) | audio(只转写)
AICBILI_MODE=auto
# 期望清晰度 qn：80=1080P(需登录) 64=720P 32=480P
AICBILI_QUALITY=80
AICBILI_OUTPUT_DIR=./output
# 缓存目录（留空 = 输出目录下的 .aicbili_cache）
# AICBILI_CACHE_DIR=
# 1=保留中间文件（音频/帧），便于排查
AICBILI_KEEP_CACHE=0
AICBILI_RETRIES=3

# ═══ 7. native 模式用的中转代理（可选）═══
# 本机 ffmpeg 能靠 --headers 注入 Referer，但云端模型不能。
# 想要"模型直读视频"，需要一个会补 Referer 的反向代理，填它的前缀地址：
# AICBILI_RELAY=https://my-worker.example.workers.dev/r
